{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.4.5",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "action": {
    "default_title": "__MSG_openAction__"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "file:///*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
